# 2025-11-04 17:03:55.487080
+CREATE VIEW IF NOT EXISTS valid_groups AS
+SELECT group_id
+FROM questions
+WHERE group_id IS NOT NULL
+GROUP BY group_id
+HAVING COUNT(*) = 5;
+
+CREATE VIEW IF NOT EXISTS groups_view AS 
+SELECT
+    group_id,
+    group_concat(answer, '|') AS options,
+    count(*) as opt_count
+FROM questions
+WHERE (group_id IS NOT NULL)
+AND status = 1
+GROUP BY group_id;
+
+CREATE VIEW questions_view AS
+SELECT 
+    question_id,
+    group_id,
+    tag_id,
+    tag_name,
+    question,
+    qtype_id,
+    format,
+    answer,
+    atype_id,
+    options,
+    rights,
+    wrongs,
+    CASE 
+        WHEN total = 0 THEN 1
+        ELSE
+            CASE 
+                WHEN score < 1 THEN 1
+                WHEN score > 5 THEN 5
+                ELSE CAST(score AS INTEGER) + (score > CAST(score AS INTEGER))
+            END
+    END AS level,
+    status,
+    comment,
+    copyright,
+    created_by,
+    created_time,
+    updated_by,
+    updated_time
+FROM (
+    SELECT 
+        q.question_id,
+        q.group_id,
+        t.tag_id, 
+        t.tag_name,
+        q.question,
+        q.qtype_id,
+        q.format,
+        q.answer,
+        q.atype_id,
+        g.options,
+        q.rights,
+        q.wrongs,
+        q.status,
+        q.comment,
+        q.copyright,
+        q.created_by,
+        q.created_time,
+        q.updated_by,
+        q.updated_time,
+        (q.wrongs + q.rights) AS total,
+        ((q.wrongs * 50.0) / ((q.wrongs + q.rights) * 8)) AS score
+    FROM questions q
+    JOIN categories c ON c.question_id = q.question_id
+    JOIN tags t ON c.tag_id = t.tag_id
+    LEFT JOIN groups_view g ON q.group_id = g.group_id
+) AS derived;
+

